# Copie este arquivo para .env (uso local) ou cadastre as variáveis no Render.

# Supabase > botão "Connect" > Session pooler (funciona em IPv4). Troque [YOUR-PASSWORD] pela senha do banco.
# Sem esta variável, a API usa um SQLite local (eventflow.db) — bom para testar no PC.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Gere uma chave longa e aleatória: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cole-aqui-uma-chave-longa-e-aleatoria
JWT_EXPIRA_DIAS=30

# OPCIONAL: fotos no Supabase Storage. Sem SUPABASE_SERVICE_KEY, as fotos ficam no próprio banco.
# Supabase > Project Settings > API Keys > chave secreta (sb_secret_...). Nunca coloque no app mobile.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx
SUPABASE_BUCKET=eventos

UPLOAD_MAX_MB=5

# true = cria usuário de teste e dados de exemplo ao subir (só o que ainda não existe)
SEED_DEMO=true
